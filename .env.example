# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# Supabase Postgres, transaction-mode pooler connection string.
# Find it in: Supabase dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
